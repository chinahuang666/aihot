# AIhot 环境配置样例（复制为 .env 后按需修改）
# 默认即为「纯规则」模式，无需任何密钥即可运行。

# ---- 可选：LLM 摘要（默认关闭）----
# 仅当同时设置 API Key 且预算 > 0 时，llm_summary 才会被调用；
# 否则始终回退到规则摘要（确定性、零成本）。
AIHOT_LLM_API_KEY=
AIHOT_LLM_BUDGET=0
# AIHOT_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# ---- 可选：GitHub 发布源鉴权（默认用公开 Atom Feed，无需密钥）----
# 若希望改用 GitHub API（更高频率），可填入 token；否则保持空。
AIHOT_GITHUB_TOKEN=
